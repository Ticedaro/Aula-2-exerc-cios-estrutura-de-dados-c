#include <stdio.h>

int maior(int a, int b)
{
    if (a > b)
        return a;
    else
        return b;
}

int menor(int a, int b)
{
    if (a < b)
        return a;
    else
        return b;
}

float media(float a, float b)
{
    return (a + b) / 2;
}

int fatorial(int n)
{
    if (n <= 1)
        return 1;
    else
        return n * fatorial(n - 1);
}

int main()
{
    int x, y, n;

    printf("=== Exercicio 8 - Funcoes ===\n\n");

    printf("Digite dois numeros inteiros:\n");
    printf("Primeiro: ");
    scanf("%d", &x);
    printf("Segundo: ");
    scanf("%d", &y);

    printf("\n--- Resultados ---\n");
    printf("Maior entre %d e %d: %d\n", x, y, maior(x, y));
    printf("Menor entre %d e %d: %d\n", x, y, menor(x, y));
    printf("Media entre %d e %d: %.2f\n", x, y, media((float)x, (float)y));

    printf("\nDigite um numero para calcular o fatorial: ");
    scanf("%d", &n);

    if (n < 0)
        printf("Fatorial nao definido para numeros negativos.\n");
    else
        printf("Fatorial de %d: %d\n", n, fatorial(n));

    return 0;
}
