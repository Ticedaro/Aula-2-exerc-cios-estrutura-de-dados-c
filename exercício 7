#include <stdio.h>
#include <string.h>

#define MAX 50

int main()
{
    char nome1[MAX], nome2[MAX];
    int resultado;

    printf("=== Exercicio 7 - Comparacao de Strings ===\n\n");

    printf("Digite o primeiro nome: ");
    fgets(nome1, MAX, stdin);
    nome1[strcspn(nome1, "\n")] = '\0';

    printf("Digite o segundo nome: ");
    fgets(nome2, MAX, stdin);
    nome2[strcspn(nome2, "\n")] = '\0';

    resultado = strncmp(nome1, nome2, MAX);

    printf("\n--- Resultado ---\n");

    if (resultado == 0)
    {
        printf("Os nomes sao iguais: \"%s\"\n", nome1);
    }
    else if (resultado < 0)
    {
        printf("Os nomes sao diferentes.\n");
        printf("\"%s\" e alfabeticamente menor que \"%s\".\n", nome1, nome2);
        printf("Ou seja, \"%s\" vem antes no dicionario.\n", nome1);
    }
    else
    {
        printf("Os nomes sao diferentes.\n");
        printf("\"%s\" e alfabeticamente maior que \"%s\".\n", nome1, nome2);
        printf("Ou seja, \"%s\" vem depois no dicionario.\n", nome1);
    }

    return 0;
}
