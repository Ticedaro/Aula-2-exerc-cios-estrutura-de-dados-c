#include <stdio.h>

#define TAM 20

int main()
{
    int vetor[TAM];
    int i;
    int maior, menor;
    int qtd_pares = 0, qtd_impares = 0;
    float soma = 0, media;

    printf("=== Exercicio 2 - Estatisticas de um Vetor ===\n\n");

    printf("Digite %d numeros inteiros:\n", TAM);
    for (i = 0; i < TAM; i++)
    {
        printf("Posicao %d: ", i);
        scanf("%d", &vetor[i]);
    }

    maior = vetor[0];
    menor = vetor[0];

    for (i = 0; i < TAM; i++)
    {
        soma += vetor[i];

        if (vetor[i] > maior)
            maior = vetor[i];

        if (vetor[i] < menor)
            menor = vetor[i];

        if (vetor[i] % 2 == 0)
            qtd_pares++;
        else
            qtd_impares++;
    }

    media = soma / TAM;
    
    printf("\n--- Resultados ---\n");
    printf("Maior valor: %d\n", maior);
    printf("Menor valor: %d\n", menor);
    printf("Media dos elementos: %.2f\n", media);
    printf("Quantidade de pares: %d\n", qtd_pares);
    printf("Quantidade de impares: %d\n", qtd_impares);

    return 0;
}
